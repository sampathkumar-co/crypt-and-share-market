# Host-side Compose settings
TRADEBOT_BIND_ADDRESS=127.0.0.1
TRADEBOT_HOST_PORT=8000
TRADEBOT_IMAGE=tradebot:local

# Public deployments are read-only by default.
TRADEBOT_ENABLE_MUTATIONS=false

# Required only when mutations are enabled on a public deployment.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
TRADEBOT_ADMIN_TOKEN=

# Optional image metadata used by local Compose builds.
VCS_REF=local
BUILD_DATE=local
